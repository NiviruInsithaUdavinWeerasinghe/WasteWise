# dependencies
/node_modules
backend/node_modules/
app/node_modules/
.venv/
venv/
/.pnp
.pnp.js

# env files
.env
backend/.env
ml_service/.env

# testing
/coverage

# production
/build

# misc
.DS_Store
.env.local
